# Spring lee variables exportadas por el proceso.
SPRING_PROFILES_ACTIVE=demo,mysql
DB_URL=jdbc:mysql://mysql.example.org:3306/metropolitano?sslMode=VERIFY_IDENTITY
DB_USER=metropolitano
DB_PASSWORD=
# Selecciona el perfil demo,postgres para usar PostgreSQL.
POSTGRES_DB_URL='jdbc:postgresql://postgres.example.org:5432/metropolitano?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory'
POSTGRES_DB_USER=metropolitano
POSTGRES_DB_PASSWORD=
GEMINI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=10000
