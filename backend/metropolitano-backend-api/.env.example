# Spring lee estas variables del proceso. Usa una rama Neon de desarrollo.
SPRING_PROFILES_ACTIVE=demo,postgres
POSTGRES_DB_URL='jdbc:postgresql://ep-example-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory'
POSTGRES_DB_USER=metropolitano
POSTGRES_DB_PASSWORD=
# Con el esquema migrado, la aplicación solo necesita permisos de lectura y escritura.
SPRING_FLYWAY_ENABLED=false
GEMINI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=10000
